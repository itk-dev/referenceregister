<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Referenceregister{% endblock %}</title>
    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
              integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
              crossorigin="anonymous">
    {% endblock %}

    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
{% block body %}
    {% block navigation %}
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('app_default') }}">{{ 'Referenceregister'|trans }}</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        {% set menu_items = [
                            {
                                route: 'app_entry_add',
                                label: 'Add entry'|trans,
                            },
                            {
                                route: 'app_entry_look_up',
                                label: 'Look up'|trans,
                            }, {
                                route: 'app_entry_remove',
                                label: 'Remove entry'|trans,
                            },
                        ] %}

                        {% if is_granted(enum('App\\Entity\\Role').ADMIN.value) %}
                            {% set menu_items = menu_items|merge([{
                                route: 'admin',
                                label: 'Administration'|trans,
                            }]) %}
                        {% endif %}

                        {% for item in menu_items %}
                            {% set active = app.current_route starts with item.route %}
                            <li class="nav-item">
                                <a class="nav-link {{ active ? 'active' }}" {{ active ? 'aria-current="page"' }}
                                   href="{{ path(item.route) }}">
                                    {{ item.label }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                               aria-expanded="false">
                                {{ app.user }}
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('_logout_main') }}">{{ 'Log out'|trans }}</a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    {% endblock %}
    <div class="container-fluid">
        <h1>{{ block('title') }}</h1>
        {% block content %}{% endblock %}
    </div>
{% endblock %}
</body>
</html>
