<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Referenceregister{% endblock %}</title>
    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
              integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
              crossorigin="anonymous">
    {% endblock %}

    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
{% block body %}
    {% block navigation %}
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('app_default') }}">{{ settings.get('site_name') }}</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        {% set main_menu_items = [
                            {
                                route: 'app_entry_add',
                                label: 'Add entry'|trans,
                                permission: enum('App\\Entity\\Permission').AddEntry.value,
                            },
                            {
                                route: 'app_entry_look_up',
                                label: 'Look up'|trans,
                                permission: enum('App\\Entity\\Permission').LookUpEntry.value,
                            }, {
                                route: 'app_entry_remove',
                                label: 'Remove entry'|trans,
                                permission: enum('App\\Entity\\Permission').RemoveEntry.value,
                            },
                        ] %}
                        {% set users_manual_url = settings.get('users_manual_url') %}
                        {% if users_manual_url %}
                            {% set main_menu_items = main_menu_items|merge([{
                                url: users_manual_url,
                                label: "User's manual"|trans,
                            }]) %}
                        {% endif %}
                        {% for item in main_menu_items %}
                            {% if not item.permission is defined or is_granted(item.permission) %}
                                {% set active = item.route is defined and app.current_route starts with item.route %}
                                <li class="nav-item">
                                    <a class="nav-link {{ active ? 'active' }}" {{ active ? 'aria-current="page"' }}
                                        href="{{ item.url ?? path(item.route) }}">
                                        {{ item.label }}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>

                    {% set user_menu_items = [] %}
                    {% if is_granted(enum('App\\Entity\\Role').Manager.value) %}
                        {% set user_menu_items = user_menu_items|merge([{
                            route: 'admin',
                            label: 'Administration'|trans,
                        }]) %}
                    {% endif %}

                    {% if settings.get('enable_log_out') %}
                        {% set user_menu_items = user_menu_items|merge([{
                            route: '_logout_main',
                            label: 'Log out'|trans,
                        }]) %}
                    {% endif %}
                    {% if user_menu_items %}
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    {{ app.user }}
                                </a>
                                <ul class="dropdown-menu">
                                    {% for item in user_menu_items %}
                                        <li>
                                            <a class="dropdown-item" href="{{ path(item.route) }}">{{ item.label }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </li>
                        </ul>
                    {% else %}
                        <span class="navbar-text">{{ app.user }}</span>
                    {% endif %}
                </div>
            </div>
        </nav>
    {% endblock %}
    <div class="container-fluid">
        <h1>{{ block('title') }}</h1>

        {% block flashes %}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }}" role="alert">
                        {{ message|trans }}
                    </div>
                {% endfor %}
            {% endfor %}
        {% endblock %}

        {% block content %}{% endblock %}
    </div>
{% endblock %}
</body>
</html>
